# Generate a unique value with at least 32 characters. Never commit the real token.
API_TOKEN=

HOST=127.0.0.1
PORT=8788
UPSTREAM_MODE=browser

# Dedicated Chrome DevTools endpoint. Keep this on a loopback IP address and
# never publish port 9223 through Cloudflare Tunnel.
BROWSER_CDP_URL=http://127.0.0.1:9223
BROWSER_PAGE_ORIGIN=https://k81128.com
BROWSER_OPERATION_TIMEOUT_MS=15000

UPSTREAM_BASE_URL=
# Verified read-only query paths used by the current web client.
UPSTREAM_SPORTS_PATH=/_glaxy_91a2c0_/game/sbtGetEvents
UPSTREAM_BALANCE_PATH=/_glaxy_91a2c0_/customer/getBalance
UPSTREAM_BETS_PATH=/_glaxy_91a2c0_/bet/queryBetsWithGameKind

# Direct authenticated access is intentionally disabled until a credential is
# supplied outside the browser and the request-signing/encryption flow is
# implemented and verified. Never paste browser storage into this file.
UPSTREAM_CREDENTIAL=
SPORTS_CACHE_MS=5000
